{
  "name": "NakoLive Botswana Transport Network",
  "short_name": "NakoLive",
  "description": "Find approved taxis, kombis and buses near you across Botswana.",
  "start_url": "./app/",
  "scope": "./",
  "id": "./app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#08254d",
